{
  "name": "ecs-arena",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "vitest run --exclude **/node_modules/** --exclude **/.worktrees/** --exclude **/.claude/** --exclude **/*.heavy.test.ts",
    "test:heavy": "vitest run .heavy.test.ts --exclude **/node_modules/** --exclude **/.worktrees/** --exclude **/.claude/**",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint --deny-warnings",
    "verify": "tsx runner/src/verify.ts",
    "profile": "tsx runner/src/profile.ts",
    "bench": "tsx runner/src/bench.ts",
    "compare": "tsx runner/src/compare.ts",
    "diff": "tsx runner/src/diff.ts",
    "check:caps": "tsx runner/src/check-capabilities.ts",
    "verify:all": "tsx runner/src/verify-all.ts",
    "budget": "tsx runner/src/budget.ts",
    "results": "tsx runner/src/results.ts",
    "build:bench": "tsx runner/src/build-entries.ts",
    "bench:submit": "tsx runner/src/build-entries.ts --submit",
    "import:benchbox": "tsx runner/src/import-benchbox.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.2.0"
  }
}
